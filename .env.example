# URL publique de l'API NestJS. Valeur d'exemple seulement.
# Ne jamais mettre de mot de passe, jeton Firebase ou secret dans EXPO_PUBLIC_*. 
EXPO_PUBLIC_API_BASE_URL=https://api.example.com

# Valeurs publiques du MÊME projet Firebase que medilink-api (pas des secrets).
# Client OAuth 2.0 de type Web, pas Android. Obligatoires pour Google natif.
EXPO_PUBLIC_FIREBASE_WEB_API_KEY=YOUR_FIREBASE_WEB_API_KEY
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=YOUR_GOOGLE_WEB_OAUTH_CLIENT_ID.apps.googleusercontent.com
