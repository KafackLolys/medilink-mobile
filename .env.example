# URL publique de l'API NestJS. Valeur d'exemple seulement.
# Ne jamais mettre de mot de passe, jeton Firebase ou secret dans EXPO_PUBLIC_*. 
EXPO_PUBLIC_API_BASE_URL=https://api.example.com

# Identifiants publics nécessaires à Google Sign-In natif (Android development build).
# Utiliser le même projet Firebase Auth que l'API; ne pas inclure de clés privées.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
