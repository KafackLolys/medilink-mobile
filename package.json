    "test:http": "node --experimental-strip-types --test src/services/http-client.test.mjs",
    "test:auth": "node --experimental-strip-types --test src/features/auth/validation.test.mjs",
    "test:session": "node --experimental-strip-types --test src/features/auth/session-manager.test.mjs",
    "test:onboarding": "node --experimental-strip-types --test src/features/auth/account-states.test.mjs",
    "test:patient": "node --experimental-strip-types --test src/features/patient/dashboard-model.test.mjs",
    "test:doctors": "node --experimental-strip-types --test src/features/patient/doctor-directory.test.mjs",
    "test:doctor-profile": "node --experimental-strip-types --test src/features/patient/doctor-profile.test.mjs",
    "test:needs": "node --experimental-strip-types --test src/features/patient/need-model.test.mjs",
    "test:appointments": "node --experimental-strip-types --test src/features/patient/appointment-booking.test.mjs",
    "test:patient-profile": "node --experimental-strip-types --test src/features/patient/patient-medical-profile.test.mjs",
    "test:doctor-dashboard": "node --experimental-strip-types --test src/features/doctor/doctor-dashboard.test.mjs",
    "test:doctor-needs": "node --experimental-strip-types --test src/features/doctor/doctor-needs.test.mjs",
    "test:doctor-agenda": "node --experimental-strip-types --test src/features/doctor/doctor-agenda.test.mjs",
    "test:doctor-profile-edit": "node --experimental-strip-types --test src/features/doctor/doctor-professional-profile.test.mjs"
  },
  "private": true
